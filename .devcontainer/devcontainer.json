{
  "name": "AgroStream Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {},
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y docker.io",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform"
      ]
    }
  },
  "remoteUser": "vscode"
}
